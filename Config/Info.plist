<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. iOS knows no type for .pgn files; without this
	     declaration they get a dynamic type that matches nothing and are greyed out in Files. -->
	<!-- The app's Documents folder in Files (On My iPhone › Chess Analyzer): saved imports. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.creatica.chessanalyzer.pgn</string>
			<key>UTTypeDescription</key>
			<string>PGN Chess Game</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pgn</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-chess-pgn</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- So a .pgn file can be opened in the app from Files or the share sheet. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PGN Chess Game</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.creatica.chessanalyzer.pgn</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
